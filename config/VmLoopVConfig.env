# Runtime settings sourced by /etc/loopv/tproxy-setup.sh.
WINDOWS_ADDRESS="172.21.200.1"

# Rules use protocol:port[,port-range...]=target-ip, separated by semicolons.
# Port forwarding is limited to traffic addressed to the VM on this interface.
PORT_FORWARD_IN_INTERFACE="eth1"
PORT_FORWARD_SNAT="false"
# Example: PORT_FORWARD_RULES="tcp:8080,8081=${WINDOWS_ADDRESS}"
PORT_FORWARD_RULES=""
